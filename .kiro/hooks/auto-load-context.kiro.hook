{
  "enabled": true,
  "name": "Auto-load Project Context",
  "description": "Automatically reads steering files from .kiro/steering when user says 'hi' or 'continue' to provide project context",
  "version": "1",
  "when": {
    "type": "promptSubmit"
  },
  "then": {
    "type": "askAgent",
    "prompt": "The user said 'hi' or 'continue'. Read all steering files in .kiro/steering/ to understand the current project context and session state, then respond appropriately based on what you find there."
  },
  "workspaceFolderName": "01propertism",
  "shortName": "auto-load-context"
}
