# Copy this file to `.env` for local development overrides.
# Leave these commented out if you want to keep using SQLite locally.

# DJANGO_ENV=development
# DEBUG=True

# Option 1: individual PostgreSQL variables
# POSTGRES_DB=propertism_local
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# Option 2: single connection string
# DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5432/propertism_local

# SQLite fallback if no PostgreSQL variables are set
# DB_PATH=db.sqlite3

# ==============================================================================
# GOOGLE SIGN-IN (OAuth 2.0)
# ==============================================================================
# Required for Google Sign-In via django-allauth.
# Get credentials from: https://console.cloud.google.com/apis/credentials
#
# Authorized redirect URI must include:
#   http://localhost:8000/accounts/google/login/callback/
#   https://www.propertism.in/accounts/google/login/callback/
#
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# ==============================================================================
# GOOGLE reCAPTCHA V2
# ==============================================================================
# Required for form spam protection.
# Get credentials from: https://www.google.com/recaptcha/admin/create
# Choose: reCAPTCHA v2 -> "I'm not a robot" Checkbox
#
# RECAPTCHA_SITE_KEY=your-recaptcha-site-key
# RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
# RECAPTCHA_FAIL_OPEN=True

# ==============================================================================
# realBOT INTEGRATION (Milestones M2.1 & M2.2)
# ==============================================================================
# REALBOT_INTEGRATION_ENABLED=False
# REALBOT_BASE_URL=http://127.0.0.1:8010
# REALBOT_API_KEY=your-realbot-api-key-here
# REALBOT_TENANT=propertism
# REALBOT_PRODUCT=propertism.in
# REALBOT_DOMAIN=real_estate
# REALBOT_ENVIRONMENT=development
# REALBOT_WIDGET_URL=http://127.0.0.1:8010
# REALBOT_API_VERSION=v1

